<?xml version="1.0" encoding="UTF-8" ?>

<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:FitnessTracker.Views"
       x:Class="FitnessTracker.AppShell"
       TabBarBackgroundColor="#FFFFFF"
       TabBarForegroundColor="#1F2937"
       TabBarUnselectedColor="#9CA3AF">

    <TabBar>
        <Tab Title="Home" Icon="home.png">
            <ShellContent ContentTemplate="{DataTemplate views:HomePage}" />
        </Tab>
        <Tab Title="Workouts" Icon="workouts.png">
            <ShellContent ContentTemplate="{DataTemplate views:WorkoutPage}" />
        </Tab>
        <Tab Title="Progress" Icon="progress.png">
            <ShellContent ContentTemplate="{DataTemplate views:ProgressPage}" />
        </Tab>
    </TabBar>

</Shell>