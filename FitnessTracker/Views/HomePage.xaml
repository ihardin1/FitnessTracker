<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="FitnessTracker.Views.HomePage"
    BackgroundColor="{StaticResource PageBackgroundColor}"
    Shell.NavBarIsVisible="False">

    <ScrollView>

        <VerticalStackLayout
            Padding="20,24,20,35"
            Spacing="20">

            <!-- Greeting -->

            <VerticalStackLayout Spacing="3">

                <Label
                    Text="{Binding Greeting}"
                    FontSize="28"
                    FontAttributes="Bold"
                    TextColor="{StaticResource PrimaryTextColor}" />

                <Label
                    Text="{Binding CurrentDate}"
                    FontSize="14"
                    TextColor="{StaticResource SecondaryTextColor}" />

                <Label
                    Text="Ready to make progress today?"
                    Margin="0,5,0,0"
                    FontSize="15"
                    TextColor="{StaticResource SecondaryTextColor}" />

            </VerticalStackLayout>

            <!-- Main progress card -->

            <Border
                Padding="20"
                BackgroundColor="#191C2C"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 22">

                <VerticalStackLayout Spacing="18">

                    <Grid ColumnDefinitions="*,Auto">

                        <VerticalStackLayout Spacing="3">

                            <Label
                                Text="TODAY'S PROGRESS"
                                FontSize="11"
                                FontAttributes="Bold"
                                TextColor="#BFC3D9" />

                            <Label
                                Text="Keep showing up"
                                FontSize="21"
                                FontAttributes="Bold"
                                TextColor="White" />

                        </VerticalStackLayout>

                        <Label
                            Grid.Column="1"
                            Text="🔥"
                            FontSize="28"
                            VerticalOptions="Center" />

                    </Grid>

                    <Grid
                        ColumnDefinitions="*,*,*"
                        ColumnSpacing="10">

                        <VerticalStackLayout Spacing="4">

                            <Label
                                Text="{Binding TotalCaloriesToday}"
                                FontSize="22"
                                FontAttributes="Bold"
                                TextColor="White"
                                HorizontalTextAlignment="Center" />

                            <Label
                                Text="Calories"
                                FontSize="12"
                                TextColor="#BFC3D9"
                                HorizontalTextAlignment="Center" />

                        </VerticalStackLayout>

                        <VerticalStackLayout
                            Grid.Column="1"
                            Spacing="4">

                            <Label
                                Text="{Binding TotalExercises}"
                                FontSize="22"
                                FontAttributes="Bold"
                                TextColor="White"
                                HorizontalTextAlignment="Center" />

                            <Label
                                Text="Exercises"
                                FontSize="12"
                                TextColor="#BFC3D9"
                                HorizontalTextAlignment="Center" />

                        </VerticalStackLayout>

                        <VerticalStackLayout
                            Grid.Column="2"
                            Spacing="4">

                            <Label
                                Text="{Binding TotalWorkouts}"
                                FontSize="22"
                                FontAttributes="Bold"
                                TextColor="White"
                                HorizontalTextAlignment="Center" />

                            <Label
                                Text="Workouts"
                                FontSize="12"
                                TextColor="#BFC3D9"
                                HorizontalTextAlignment="Center" />

                        </VerticalStackLayout>

                    </Grid>

                </VerticalStackLayout>

            </Border>

            <!-- Quick start card -->

            <Border
                Padding="18"
                BackgroundColor="{StaticResource CardBackgroundColor}"
                Stroke="{StaticResource CardBorderColor}"
                StrokeShape="RoundRectangle 18">

                <Border.GestureRecognizers>

                    <TapGestureRecognizer
                        Command="{Binding QuickStartCommand}" />

                </Border.GestureRecognizers>

                <Grid ColumnDefinitions="Auto,*,Auto">

                    <Border
                        WidthRequest="48"
                        HeightRequest="48"
                        BackgroundColor="{StaticResource SurfaceColor}"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 14">

                        <Label
                            Text="🏋️"
                            FontSize="22"
                            HorizontalOptions="Center"
                            VerticalOptions="Center" />

                    </Border>

                    <VerticalStackLayout
                        Grid.Column="1"
                        Margin="14,0"
                        Spacing="3"
                        VerticalOptions="Center">

                        <Label
                            Text="Quick Start Workout"
                            FontSize="16"
                            FontAttributes="Bold"
                            TextColor="{StaticResource PrimaryTextColor}" />

                        <Label
                            Text="Build and begin today's workout"
                            FontSize="13"
                            TextColor="{StaticResource SecondaryTextColor}" />

                    </VerticalStackLayout>

                    <Label
                        Grid.Column="2"
                        Text="›"
                        FontSize="30"
                        TextColor="{StaticResource SecondaryTextColor}"
                        VerticalOptions="Center" />

                </Grid>

            </Border>

            <!-- Weekly activity -->

            <Border
                Padding="18"
                BackgroundColor="{StaticResource CardBackgroundColor}"
                Stroke="{StaticResource CardBorderColor}"
                StrokeShape="RoundRectangle 18">

                <VerticalStackLayout Spacing="17">

                    <Grid ColumnDefinitions="*,Auto">

                        <VerticalStackLayout Spacing="3">

                            <Label
                                Text="Weekly Activity"
                                FontSize="18"
                                FontAttributes="Bold"
                                TextColor="{StaticResource PrimaryTextColor}" />

                            <Label
                                Text="Completed workout days"
                                FontSize="13"
                                TextColor="{StaticResource SecondaryTextColor}" />

                        </VerticalStackLayout>

                        <Label
                            Grid.Column="1"
                            Text="🔥"
                            FontSize="22"
                            VerticalOptions="Center" />

                    </Grid>

                    <CollectionView
                        ItemsSource="{Binding WeeklyProgress}"
                        SelectionMode="None"
                        HeightRequest="72"
                        HorizontalOptions="Fill">

                        <CollectionView.ItemsLayout>

                            <LinearItemsLayout
                                Orientation="Horizontal"
                                ItemSpacing="12" />

                        </CollectionView.ItemsLayout>

                        <CollectionView.ItemTemplate>

                            <DataTemplate>

                                <VerticalStackLayout
                                    WidthRequest="34"
                                    Spacing="7"
                                    HorizontalOptions="Center">

                                    <Label
                                        Text="{Binding DayLabel}"
                                        FontSize="12"
                                        TextColor="{StaticResource SecondaryTextColor}"
                                        HorizontalTextAlignment="Center" />

                                    <Border
                                        WidthRequest="34"
                                        HeightRequest="34"
                                        BackgroundColor="{StaticResource SurfaceColor}"
                                        Stroke="{StaticResource CardBorderColor}"
                                        StrokeShape="Ellipse">

                                        <Border.Triggers>

                                            <DataTrigger
                                                TargetType="Border"
                                                Binding="{Binding IsCompleted}"
                                                Value="True">

                                                <Setter
                                                    Property="BackgroundColor"
                                                    Value="#191C2C" />

                                                <Setter
                                                    Property="Stroke"
                                                    Value="#191C2C" />

                                            </DataTrigger>

                                        </Border.Triggers>

                                        <Label
                                            Text="○"
                                            FontSize="16"
                                            TextColor="{StaticResource SecondaryTextColor}"
                                            HorizontalOptions="Center"
                                            VerticalOptions="Center">

                                            <Label.Triggers>

                                                <DataTrigger
                                                    TargetType="Label"
                                                    Binding="{Binding IsCompleted}"
                                                    Value="True">

                                                    <Setter
                                                        Property="Text"
                                                        Value="✓" />

                                                    <Setter
                                                        Property="TextColor"
                                                        Value="White" />

                                                </DataTrigger>

                                            </Label.Triggers>

                                        </Label>

                                    </Border>

                                </VerticalStackLayout>

                            </DataTemplate>

                        </CollectionView.ItemTemplate>

                    </CollectionView>

                </VerticalStackLayout>

            </Border>

            <!-- Today's workout -->

            <Border
                Padding="18"
                BackgroundColor="{StaticResource CardBackgroundColor}"
                Stroke="{StaticResource CardBorderColor}"
                StrokeShape="RoundRectangle 18">

                <VerticalStackLayout Spacing="16">

                    <Grid ColumnDefinitions="*,Auto">

                        <VerticalStackLayout Spacing="3">

                            <Label
                                Text="Today's Workout"
                                FontSize="18"
                                FontAttributes="Bold"
                                TextColor="{StaticResource PrimaryTextColor}" />

                            <Label
                                Text="{Binding TodayWorkoutSummary}"
                                FontSize="13"
                                TextColor="{StaticResource SecondaryTextColor}" />

                        </VerticalStackLayout>

                        <Button
                            Grid.Column="1"
                            Text="Change"
                            Command="{Binding ChangeRoutineCommand}"
                            Padding="10,4"
                            HeightRequest="34"
                            FontSize="12"
                            BackgroundColor="Transparent"
                            TextColor="{StaticResource PrimaryTextColor}" />

                    </Grid>

                    <BoxView
                        HeightRequest="1"
                        BackgroundColor="{StaticResource CardBorderColor}" />

                    <CollectionView
                        ItemsSource="{Binding TodayExercises}"
                        SelectionMode="None"
                        HeightRequest="150">

                        <CollectionView.EmptyView>

                            <VerticalStackLayout
                                Padding="0,15"
                                Spacing="5"
                                HorizontalOptions="Center">

                                <Label
                                    Text="No exercises added yet"
                                    FontSize="14"
                                    FontAttributes="Bold"
                                    TextColor="{StaticResource PrimaryTextColor}"
                                    HorizontalTextAlignment="Center" />

                                <Label
                                    Text="Use Quick Start to build today's workout."
                                    FontSize="12"
                                    TextColor="{StaticResource SecondaryTextColor}"
                                    HorizontalTextAlignment="Center" />

                            </VerticalStackLayout>

                        </CollectionView.EmptyView>

                        <CollectionView.ItemTemplate>

                            <DataTemplate>

                                <Grid
                                    Padding="0,7"
                                    ColumnDefinitions="Auto,*,Auto">

                                    <Border
                                        WidthRequest="31"
                                        HeightRequest="31"
                                        BackgroundColor="{StaticResource SurfaceColor}"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 10">

                                        <Label
                                            Text="✓"
                                            FontSize="13"
                                            HorizontalOptions="Center"
                                            VerticalOptions="Center"
                                            TextColor="{StaticResource PrimaryTextColor}" />

                                    </Border>

                                    <Label
                                        Grid.Column="1"
                                        Text="{Binding Name}"
                                        Margin="11,0"
                                        FontSize="14"
                                        FontAttributes="Bold"
                                        TextColor="{StaticResource PrimaryTextColor}"
                                        VerticalOptions="Center" />

                                    <Label
                                        Grid.Column="2"
                                        Text="{Binding Details}"
                                        FontSize="13"
                                        TextColor="{StaticResource SecondaryTextColor}"
                                        VerticalOptions="Center" />

                                </Grid>

                            </DataTemplate>

                        </CollectionView.ItemTemplate>

                    </CollectionView>

                    <Button
                        Text="Open Today's Workout"
                        Command="{Binding LaunchWorkoutCommand}"
                        HeightRequest="50"
                        CornerRadius="14"
                        FontAttributes="Bold"
                        BackgroundColor="#191C2C"
                        TextColor="White" />

                </VerticalStackLayout>

            </Border>

            <!-- Motivation card -->

            <Border
                Padding="18"
                BackgroundColor="{StaticResource SurfaceColor}"
                Stroke="{StaticResource CardBorderColor}"
                StrokeShape="RoundRectangle 18">

                <Grid ColumnDefinitions="Auto,*">

                    <Label
                        Text="💪"
                        FontSize="24"
                        VerticalOptions="Center" />

                    <VerticalStackLayout
                        Grid.Column="1"
                        Margin="13,0,0,0"
                        Spacing="3">

                        <Label
                            Text="Consistency beats perfection"
                            FontSize="15"
                            FontAttributes="Bold"
                            TextColor="{StaticResource PrimaryTextColor}" />

                        <Label
                            Text="Every workout you log is another step forward."
                            FontSize="12"
                            TextColor="{StaticResource SecondaryTextColor}" />

                    </VerticalStackLayout>

                </Grid>

            </Border>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>