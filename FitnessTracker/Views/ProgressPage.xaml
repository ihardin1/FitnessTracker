<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="FitnessTracker.Views.ProgressPage"
    Title="Progress"
    BackgroundColor="{StaticResource PageBackgroundColor}">

    <ScrollView>

        <VerticalStackLayout
            Padding="20,24,20,30"
            Spacing="20">

            <!-- Header -->

            <VerticalStackLayout Spacing="4">

                <Label
                    Text="Progress"
                    FontSize="30"
                    FontAttributes="Bold"
                    TextColor="{StaticResource PrimaryTextColor}" />

                <Label
                    Text="Track your overall fitness progress."
                    FontSize="14"
                    TextColor="{StaticResource SecondaryTextColor}" />

            </VerticalStackLayout>

            <!-- Statistics Card -->

            <Border
                Padding="20"
                BackgroundColor="#191C2C"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 20">

                <VerticalStackLayout Spacing="20">

                    <Label
                        Text="Workout Statistics"
                        FontSize="18"
                        FontAttributes="Bold"
                        TextColor="White" />

                    <Grid
                        ColumnDefinitions="*,*"
                        ColumnSpacing="20">

                        <VerticalStackLayout>

                            <Label
                                Text="{Binding TotalWorkouts}"
                                FontSize="28"
                                FontAttributes="Bold"
                                TextColor="White"
                                HorizontalTextAlignment="Center" />

                            <Label
                                Text="Workouts"
                                FontSize="12"
                                TextColor="#C6CADB"
                                HorizontalTextAlignment="Center" />

                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="1">

                            <Label
                                Text="{Binding TotalExercises}"
                                FontSize="28"
                                FontAttributes="Bold"
                                TextColor="White"
                                HorizontalTextAlignment="Center" />

                            <Label
                                Text="Exercises"
                                FontSize="12"
                                TextColor="#C6CADB"
                                HorizontalTextAlignment="Center" />

                        </VerticalStackLayout>

                    </Grid>

                    <BoxView
                        HeightRequest="1"
                        Color="#3D4259"/>

                    <Grid RowDefinitions="Auto,Auto"
                          RowSpacing="12">

                        <Grid ColumnDefinitions="Auto,*">

                            <Label
                                Text="💪"
                                FontSize="20"/>

                            <Label
                                Grid.Column="1"
                                Margin="10,0,0,0"
                                Text="{Binding TotalVolume,StringFormat='Total Volume: {0:N0} lb'}"
                                FontSize="16"
                                TextColor="White"/>

                        </Grid>

                        <Grid
                            Grid.Row="1"
                            ColumnDefinitions="Auto,*">

                            <Label
                                Text="🏆"
                                FontSize="20"/>

                            <Label
                                Grid.Column="1"
                                Margin="10,0,0,0"
                                Text="{Binding FavoriteExercise,StringFormat='Favorite Exercise: {0}'}"
                                FontSize="16"
                                TextColor="White"/>

                        </Grid>

                    </Grid>

                </VerticalStackLayout>

            </Border>

            <!-- Exercise History -->

            <Label
                Text="Exercise History"
                FontSize="22"
                FontAttributes="Bold"
                TextColor="{StaticResource PrimaryTextColor}" />

            <CollectionView
                ItemsSource="{Binding ExerciseHistory}"
                SelectionMode="None">

                <CollectionView.EmptyView>

                    <Border
                        Padding="25"
                        BackgroundColor="{StaticResource CardBackgroundColor}"
                        Stroke="{StaticResource CardBorderColor}"
                        StrokeShape="RoundRectangle 18">

                        <VerticalStackLayout
                            HorizontalOptions="Center"
                            Spacing="8">

                            <Label
                                Text="📈"
                                FontSize="30"
                                HorizontalTextAlignment="Center"/>

                            <Label
                                Text="No workout history yet"
                                FontSize="16"
                                FontAttributes="Bold"
                                TextColor="{StaticResource PrimaryTextColor}"
                                HorizontalTextAlignment="Center"/>

                            <Label
                                Text="Complete a workout and it will appear here."
                                FontSize="13"
                                TextColor="{StaticResource SecondaryTextColor}"
                                HorizontalTextAlignment="Center"/>

                        </VerticalStackLayout>

                    </Border>

                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>

                    <DataTemplate>

                        <Border
                            Margin="0,0,0,12"
                            Padding="16"
                            BackgroundColor="{StaticResource CardBackgroundColor}"
                            Stroke="{StaticResource CardBorderColor}"
                            StrokeShape="RoundRectangle 18">

                            <Grid
                                ColumnDefinitions="*,Auto"
                                RowDefinitions="Auto,Auto">

                                <VerticalStackLayout
                                    Spacing="4">

                                    <Label
                                        Text="{Binding Name}"
                                        FontSize="17"
                                        FontAttributes="Bold"
                                        TextColor="{StaticResource PrimaryTextColor}" />

                                    <Label
                                        Text="{Binding Date,StringFormat='{0:MMMM d, yyyy}'}"
                                        FontSize="12"
                                        TextColor="{StaticResource SecondaryTextColor}" />

                                </VerticalStackLayout>

                                <VerticalStackLayout
                                    Grid.Column="1"
                                    HorizontalOptions="End"
                                    Spacing="4">

                                    <Label
                                        Text="{Binding Weight,StringFormat='{0} lb'}"
                                        FontSize="15"
                                        FontAttributes="Bold"
                                        HorizontalTextAlignment="End"
                                        TextColor="{StaticResource PrimaryTextColor}" />

                                    <Label
                                        Text="{Binding Sets,StringFormat='{0} sets'}"
                                        FontSize="12"
                                        HorizontalTextAlignment="End"
                                        TextColor="{StaticResource SecondaryTextColor}" />

                                    <Label
                                        Text="{Binding Reps,StringFormat='{0} reps'}"
                                        FontSize="12"
                                        HorizontalTextAlignment="End"
                                        TextColor="{StaticResource SecondaryTextColor}" />

                                </VerticalStackLayout>

                            </Grid>

                        </Border>

                    </DataTemplate>

                </CollectionView.ItemTemplate>

            </CollectionView>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>