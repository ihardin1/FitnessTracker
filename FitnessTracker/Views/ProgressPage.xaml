<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FitnessTracker.Views.ProgressPage"
             Title="Progress">

    <VerticalStackLayout Padding="20">

        <Label
            Text="Workout Progress"
            FontSize="28"
            FontAttributes="Bold"/>

        <CollectionView>

            <CollectionView.ItemTemplate>

                <DataTemplate>

                    <Frame Margin="5">

                        <VerticalStackLayout>

                            <Label
                                Text="Exercise"/>

                            <Label
                                Text="Weight"/>

                            <Label
                                Text="Reps"/>

                        </VerticalStackLayout>

                    </Frame>

                </DataTemplate>

            </CollectionView.ItemTemplate>

        </CollectionView>

    </VerticalStackLayout>

</ContentPage>